# 複製這個檔案為 .env，再填入實際的值。.env 已經在 .gitignore 裡，不會被 commit。
# 標了「必要」的變數，程式啟動時會檢查（見 lib/env.js），少了任何一個都會直接拒絕啟動。

# ── LINE Messaging API（必要）──────────────────────────────
# 在 LINE Developers Console 的 Channel 設定頁可以找到
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── OpenAI（必要）──────────────────────────────────────────
# 用於呼叫 gpt-4.1-mini 做翻譯
OPENAI_API_KEY=

# ── Firebase（必要）────────────────────────────────────────
# Firebase 專案 → 設定 → 服務帳戶 → 產生新的私密金鑰，下載整份 JSON，
# 壓成一行貼在這裡（注意 private_key 裡的換行要是 \n 這種跳脫字元，
# 不是真的換行；大多數平台的環境變數設定介面會自動處理，但本機測試
# 用 .env 檔的話要自己確認格式）
FIREBASE_CONFIG=

# ── 後台管理登入（必要）────────────────────────────────────
# 用於 /admin 後台的登入帳號密碼（session-based，見 routes/admin.js）
ADMIN_USER=
ADMIN_PASS=

# ── Session 加密金鑰（必要）────────────────────────────────
# 用於簽署 express-session 的 cookie，建議用一長串隨機字串，例如：
# openssl rand -hex 32
SESSION_SECRET=

# ── 藍新金流 NewebPay（必要）───────────────────────────────
# 商店後台 → 商店資訊 可以找到 MerchantID/HashKey/HashIV
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASHKEY=
NEWEBPAY_HASHIV=
# 選填，預設是正式環境網址；串測試環境時可以換成藍新提供的測試網址
# NEWEBPAY_MPG_URL=https://ccore.newebpay.com/MPG/mpg_gateway

# ── 選填 ───────────────────────────────────────────────────
# 網站對外的完整網址，藍新的 ReturnURL / NotifyURL 會用到，checkout 時組成
# 例如 https://your-app.example.com
BASE_URL=

# 監聽的埠號，多數 PaaS 平台（Render/Railway...）會自動注入，本機測試可以不填，預設 3000
PORT=

# 設成 production 時，session cookie 會加上 secure 旗標（只能透過 HTTPS 傳送）
NODE_ENV=

# free-tier 平台常會把閒置服務休眠，設一個外部監控網址，服務會每 10 分鐘自己戳一次保持喚醒
PING_URL=

# 設成 1 或 true 才會印出翻譯除錯 log（含使用者訊息原文、mention 還原過程），
# 平常不要開，只有在正式環境要追查 @mention / zh-TW 翻譯異常時才短暫打開
DEBUG=
