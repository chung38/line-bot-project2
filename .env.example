# 複製這個檔案為 .env，再填入實際的值。.env 已經在 .gitignore 裡，不會被 commit。
# 標了「必要」的變數，程式啟動時會檢查（見 lib/env.js），少了任何一個都會直接拒絕啟動。

# ── LINE Messaging API（必要）──────────────────────────────
# 在 LINE Developers Console 的 Channel 設定頁可以找到
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── OpenAI（必要）──────────────────────────────────────────
# 用於呼叫 gpt-4.1-mini 做翻譯
OPENAI_API_KEY=

# ── Firebase（必要）────────────────────────────────────────
# Firebase 專案 → 設定 → 服務帳戶 → 產生新的私密金鑰，下載整份 JSON，
# 壓成一行貼在這裡（注意 private_key 裡的換行要是 \n 這種跳脫字元，
# 不是真的換行；大多數平台的環境變數設定介面會自動處理，但本機測試
# 用 .env 檔的話要自己確認格式）
FIREBASE_CONFIG=

# ── 後台管理登入（必要）────────────────────────────────────
# 用於 /admin 後台的登入帳號密碼（session-based，見 routes/admin.js）
ADMIN_USER=
ADMIN_PASS=

# ── Session 加密金鑰（必要）────────────────────────────────
# 用於簽署 express-session 的 cookie，建議用一長串隨機字串，例如：
# openssl rand -hex 32
SESSION_SECRET=

# ── 藍新金流 NewebPay（必要）───────────────────────────────
# ⚠️ 測試環境與正式環境是「完全不同的兩組」商店代號與金鑰，不能混用：
#      測試： https://cwww.newebpay.com  的商店後台
#      正式： https://www.newebpay.com   的商店後台（注意沒有 c）
# 商店後台 → 商店資訊 可以找到 MerchantID / HashKey / HashIV。
# HashKey 必須剛好 32 個字元、HashIV 必須剛好 16 個字元，貼的時候不要多帶空白或換行。
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASHKEY=
NEWEBPAY_HASHIV=

# 付款閘道網址。程式的預設值是「測試環境」，正式上線一定要自己填正式網址，
# 兩者只差開頭一個 c，很容易看漏：
#   測試 https://ccore.newebpay.com/MPG/mpg_gateway  ← 預設值
#   正式 https://core.newebpay.com/MPG/mpg_gateway
# 沒填就是在打測試站：刷卡不會真的扣款，但系統會顯示付款成功。
NEWEBPAY_MPG_URL=

# ── 網站對外網址（必要）────────────────────────────────────
# 藍新的 ReturnURL / NotifyURL 是用這個組出來的，沒設會送出
# "undefined/api/member/payment-notify" 給藍新，結果是收得到錢但訂閱不會開通。
# 要填可以從外網連到的完整網址，結尾不要加斜線，正式環境必須是 https。
# 例如 https://your-app.example.com
BASE_URL=

# ── 選填 ───────────────────────────────────────────────────

# 監聽的埠號，多數 PaaS 平台（Render/Railway...）會自動注入，本機測試可以不填，預設 3000
PORT=

# 設成 production 時，session cookie 會加上 secure 旗標（只能透過 HTTPS 傳送）
NODE_ENV=

# free-tier 平台常會把閒置服務休眠，設一個外部監控網址，服務會每 10 分鐘自己戳一次保持喚醒
PING_URL=

# 設成 1 或 true 才會印出翻譯除錯 log（含使用者訊息原文、mention 還原過程），
# 平常不要開，只有在正式環境要追查 @mention / zh-TW 翻譯異常時才短暫打開
DEBUG=

# 訂閱到期提醒：到期前 7/3/1 天以及到期當下，各推播一則訊息到該群組。
# 每個提醒每個訂閱週期只會發一次（續約後會重新計算），所以一個群組一輪最多 4 則。
# ⚠️ 這會用到 LINE 的推播訊息額度（回覆訊息不計費，推播才計費），
#    群組數量多的時候請先確認官方帳號的方案額度夠不夠。
# 設成 off 可以完全關閉。
EXPIRY_REMINDER=

# 提醒訊息裡「前往續約」的連結，留空就用 BASE_URL/member.html
MEMBER_PAGE_URL=

# 訂單付款期限（天），預設 3。開放 ATM 轉帳後這個值取代了原本的 30 分鐘：
# 虛擬帳號的繳費期限是以「天」計算的，訂單如果比帳號早失效，會出現
# 「使用者的帳號還能轉、後台卻已標成逾期」的矛盾。
# ⚠️ 這個天數必須 >= 你在藍新後台設定的「虛擬帳號繳費期限」。
ORDER_PENDING_DAYS=
