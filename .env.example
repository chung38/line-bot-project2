# 複製這個檔案為 .env，再填入實際的值。.env 已經在 .gitignore 裡，不會被 commit。
# 標了「必要」的變數，程式啟動時會檢查（見 lib/env.js），少了任何一個都會直接拒絕啟動。

# ── LINE Messaging API（必要）──────────────────────────────
# 在 LINE Developers Console 的 Channel 設定頁可以找到
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── OpenAI（必要）──────────────────────────────────────────
OPENAI_API_KEY=

# 翻譯用的模型名稱。**沒有預設值**，一定要填你實際在用的那個，
# 不要照抄這裡的範例——填錯模型名稱 OpenAI 會直接回 404。
# 程式會自己偵測是不是推理模型，並切換 max_completion_tokens / reasoning_effort，
# 不用改程式碼。
# 例如 OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL=

# ── Firebase（必要）────────────────────────────────────────
# Firebase 專案 → 設定 → 服務帳戶 → 產生新的私密金鑰，下載整份 JSON，
# 壓成一行貼在這裡（注意 private_key 裡的換行要是 \n 這種跳脫字元，
# 不是真的換行；大多數平台的環境變數設定介面會自動處理，但本機測試
# 用 .env 檔的話要自己確認格式）
FIREBASE_CONFIG=

# ── 後台管理登入（必要）────────────────────────────────────
# 用於 /admin 後台的登入帳號密碼（session-based，見 routes/admin.js）
ADMIN_USER=
ADMIN_PASS=

# ── Session 加密金鑰（必要）────────────────────────────────
# 用於簽署 express-session 的 cookie，建議用一長串隨機字串，例如：
# openssl rand -hex 32
SESSION_SECRET=

# ── 藍新金流 NewebPay（必要）───────────────────────────────
# ⚠️ 測試環境與正式環境是「完全不同的兩組」商店代號與金鑰，不能混用：
#      測試： https://cwww.newebpay.com  的商店後台
#      正式： https://www.newebpay.com   的商店後台（注意沒有 c）
# 商店後台 → 商店資訊 可以找到 MerchantID / HashKey / HashIV。
# HashKey 必須剛好 32 個字元、HashIV 必須剛好 16 個字元，貼的時候不要多帶空白或換行。
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASHKEY=
NEWEBPAY_HASHIV=

# 付款閘道網址。程式的預設值是「測試環境」，正式上線一定要自己填正式網址，
# 兩者只差開頭一個 c，很容易看漏：
#   測試 https://ccore.newebpay.com/MPG/mpg_gateway  ← 預設值
#   正式 https://core.newebpay.com/MPG/mpg_gateway
# 沒填就是在打測試站：刷卡不會真的扣款，但系統會顯示付款成功。
NEWEBPAY_MPG_URL=

# ── 網站對外網址（必要）────────────────────────────────────
# 藍新的 ReturnURL / NotifyURL 是用這個組出來的，沒設會送出
# "undefined/api/member/payment-notify" 給藍新，結果是收得到錢但訂閱不會開通。
# 要填可以從外網連到的完整網址，結尾不要加斜線，正式環境必須是 https。
# 例如 https://your-app.example.com
BASE_URL=

# ── 選填 ───────────────────────────────────────────────────

# 譯文要不要加上「【某某】說：」這一行，預設 auto。
#   auto   有引用區塊（quoteToken）就省略，沒有才顯示
#   always 一律顯示（回到加 quoteToken 之前的樣子）
#   never  一律不顯示——沒有引用的那幾則會看不出在翻誰的話
# 語音與圖片不受影響到「逐字稿」那部分：拿掉的只有名字，
# 「語音：」「圖片文字：」加上抽出來的原文一律保留。
SPEAKER_LABEL_MODE=

# 監聽的埠號，多數 PaaS 平台（Render/Railway...）會自動注入，本機測試可以不填，預設 3000
PORT=

# 設成 production 時，session cookie 會加上 secure 旗標（只能透過 HTTPS 傳送）
NODE_ENV=

# free-tier 平台常會把閒置服務休眠，設一個外部監控網址，服務會每 10 分鐘自己戳一次保持喚醒
PING_URL=

# 設成 1 或 true 才會印出翻譯除錯 log（含使用者訊息原文、mention 還原過程），
# 平常不要開，只有在正式環境要追查 @mention / zh-TW 翻譯異常時才短暫打開
DEBUG=

# 訂閱到期提醒：到期前 7 天、以及到期當下，各推播一則給「當初邀請機器人的那個人」
# 的 1:1 聊天室（不是群組）。每個提醒每個訂閱週期只會發一次（續約後重新計算），
# 所以一個群組一輪最多 2 則、每則只算 1 個收件人。
#
# ⚠️ 推播是「按收件人數」計費的：推一則到 20 人的群組 = 20 則額度。
#    原本的設計是 7/3/1/到期 四個時間點都推群組，一個 20 人群組一輪就吃掉 80 則，
#    中用量方案（3,000 則/月）只撐得住約 37 個群組。改成 1:1 之後同樣的額度
#    可以支撐約 1,500 個群組。
#
# 找不到邀請者、或對方從來沒私訊過官方帳號（推不到）時，會直接跳過不發，
# **不會退回去推群組**——群組成員收到一則跟自己無關的續約通知，
# 對他們是噪音，對你是 N 倍額度。
# 設成 off 可以完全關閉。
EXPIRY_REMINDER=

# 提醒訊息裡「前往續約」的連結，留空就用 BASE_URL/member.html
MEMBER_PAGE_URL=

# 訂單付款期限（天），預設 3。開放 ATM 轉帳後這個值取代了原本的 30 分鐘：
# 虛擬帳號的繳費期限是以「天」計算的，訂單如果比帳號早失效，會出現
# 「使用者的帳號還能轉、後台卻已標成逾期」的矛盾。
# ⚠️ 這個天數必須 >= 你在藍新後台設定的「虛擬帳號繳費期限」。
ORDER_PENDING_DAYS=

# ── 翻譯行為 ───────────────────────────────────────────────

# 單則訊息的字數上限，預設 1500。超過就回「訊息太長」，而且**不扣額度**。
# 這是防呆也是防濫用：一則訊息跟一本小說扣一樣多額度（1 則 = 1 次）。
MAX_TRANSLATE_CHARS=

# ok / OK / Oke / okay 這類「收到」的回應要不要跳過翻譯，預設開啟。
# 這些字所有國籍的員工都看得懂，翻出來是純噪音，卻照樣要吃 1 次額度
# 加上每個目標語言各一次 OpenAI 呼叫。設成 false 就恢復照常翻譯。
# 只認 ok 家族：ya / siap（印尼文）、noted（英文）、好的（中文）照常翻譯，
# 因為那些字不是所有人都看得懂。詳細判定表見 README。
SKIP_ACK_MESSAGES=

# 機器人被加進新群組時要回什麼，預設 hint。
#   menu   直接跳語言選單
#   hint   只回一句提示，請管理者自己打 !啟動
#   silent 完全不回（適合不想打擾既有群組的情況）
JOIN_MESSAGE_MODE=

# OpenAI 回應的 token 上限，預設 2000。譯文被截斷時才需要調大。
OPENAI_MAX_COMPLETION_TOKENS=

# 推理模型的推理強度，預設 none。只有在用推理模型、而且譯文品質不穩時才需要動。
# 調高會明顯增加延遲與費用。
OPENAI_REASONING_EFFORT=

# ── 語音翻譯 ───────────────────────────────────────────────

# 轉寫用的模型，預設 whisper-1。
# 程式會自己探測模型支援哪些參數（有些新模型不吃 temperature / verbose_json），
# 換模型不用改程式碼。
OPENAI_TRANSCRIBE_MODEL=

# 音檔長度上限（秒），預設 60。超過直接拒絕，不會送去轉寫。
# ⚠️ LINE 的 duration 欄位「不保證一定有」，所以還有下面的位元組上限當第二道防線。
MAX_AUDIO_SECONDS=

# 音檔大小上限（位元組），預設 8388608（8MB）。
# 這道防線是**邊下載邊檢查**的，超過就中斷連線，不會先把整個檔案收完才判斷——
# 不然有人故意錄一個 2 小時的音檔就能把記憶體吃光。
MAX_AUDIO_BYTES=

# 太短的音檔（毫秒）直接忽略，預設 1000。誤觸錄音鍵產生的 0.3 秒雜音不值得花錢轉寫。
MIN_AUDIO_MS=

# 同時進行的轉寫數量上限，預設 3。這個鎖是在**扣額度之前**拿的，
# 所以塞車的時候是「稍後再試」，不是「額度被扣了但沒結果」。
MAX_CONCURRENT_TRANSCRIPTIONS=

# 下載音檔的逾時（毫秒），預設 15000。
AUDIO_FETCH_TIMEOUT_MS=

# 轉寫結果的信心門檻。低於 AUDIO_MIN_AVG_LOGPROB（預設 -1.0）或
# no_speech 機率高於 AUDIO_NO_SPEECH_THRESHOLD（預設 0.6）就當作「聽不出內容」，
# 回一句提示而不是硬翻一段亂碼。想讓它更寬鬆就把 logprob 調更負。
AUDIO_MIN_AVG_LOGPROB=
AUDIO_NO_SPEECH_THRESHOLD=

# 轉寫提示詞與專有名詞，兩者都留空就不送。
# 工廠/看護情境的機台型號、人名、藥名可以放這裡提升辨識率，逗號分隔。
# 例如 TRANSCRIBE_KEYWORDS=射出機,堆高機,血壓計
TRANSCRIBE_PROMPT=
TRANSCRIBE_KEYWORDS=

# ── 圖片文字翻譯 ───────────────────────────────────────────

# **留空就完全不啟用**，圖片訊息會像沒有這個功能一樣被忽略。
# 要啟用就填一個支援視覺輸入的模型名稱。
OPENAI_VISION_MODEL=

# 圖片大小上限（位元組），預設 4194304（4MB）。
MAX_IMAGE_BYTES=

# ── 效能與快取 ─────────────────────────────────────────────

# 群組成員顯示名稱的快取，預設最多 2000 筆、存 6 小時。
# 每則要加「【某某】說：」的訊息本來都要打一次 LINE API，快取之後同一個人
# 在 6 小時內只打一次。查詢**失敗的結果刻意不快取**，不然成員剛加入時查不到，
# 接下來 6 小時都會顯示不出名字。
DISPLAY_NAME_CACHE_MAX=
DISPLAY_NAME_CACHE_TTL_MS=

# 優雅關閉時等背景任務結清的上限（毫秒），預設 25000。
# log 裡常看到「⚠️ 排乾逾時」就調小一點（Render 的 SIGTERM 寬限期是 30 秒）。
SHUTDOWN_DRAIN_MS=

# 群組設定的同步方式，預設 realtime（Firestore 即時監聽）。
# 環境不允許長連線時設成 poll。
STATE_SYNC_MODE=
